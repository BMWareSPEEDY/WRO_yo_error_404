[Unit]
Description=WRO 2026 - Parking Exit Master (~/parking/parking_master.py)
Wants=dashboard.service
After=dashboard.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/parking
ExecStart=/usr/bin/python3 -u /home/pi/parking/parking_master.py
Restart=always
RestartSec=3
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
