[Unit]
Description=WRO 2026 - dashboard + ESP32 relay (~/obstacle_round/dashboard.py), always on
# NOT After=multi-user.target: master.service is ordered after this unit and
# multi-user.target waits for master.service, so that made an ordering cycle and
# systemd silently dropped master.service at boot.
After=network.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video dialout i2c gpio spi render input
WorkingDirectory=/home/pi/obstacle_round
# No camera probe here. It used to wait up to 30 s for a CSI camera at boot,
# which is 30 s of no dashboard and no ESP32 relay - and the CSI camera is dead
# anyway; the car runs a USB webcam, which needs no probe. dashboard.py opens
# whatever camera it finds in a background thread, so the page and the relay
# are live within seconds of power-on whether a camera is attached or not.
ExecStart=/usr/bin/python3 -u /home/pi/obstacle_round/dashboard.py
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
